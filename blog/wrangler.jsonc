{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devsite",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Lets the worker revalidate pages by calling itself. Must match "name".
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "devsite" }],
  // Cached pages and CMS responses, refreshed every 5 minutes.
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "devsite-cache" }],
  // Queues those background refreshes so each page only regenerates once.
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "observability": { "enabled": true }
}
